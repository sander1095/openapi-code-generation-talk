<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- https://learn.microsoft.com/en-us/aspnet/core/web-api/advanced/analyzers?view=aspnetcore-10.0 -->
    <IncludeOpenAPIAnalyzers>true</IncludeOpenAPIAnalyzers>
    <!-- ASPDEPR007: the MVC API analyzers are deprecated in .NET 10, but still work and are part of the demo. -->
    <NoWarn>$(NoWarn);1591;ASPDEPR007</NoWarn>

    <!-- Useful for the prebuild/ folder -->
    <PublishSingleFile>false</PublishSingleFile> <!-- false because of missing XML comments-->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
